# ============================================================================
# CommerceFlow — development environment (docker compose up -d --build)
# Copy to .env and adjust. All values are optional; sane defaults are shown.
# ============================================================================

# --- Ports published on the host -------------------------------------------------
FRONTEND_PORT=3000
BACKEND_PORT=4000
POSTGRES_PORT=5432
REDIS_PORT=6379

# --- PostgreSQL (container-internal defaults unless overridden) -------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=commerceflow

# --- Redis -----------------------------------------------------------------------
# Leave empty for a passwordless local Redis. If set, the container requires it.
REDIS_PASSWORD=

# --- Backend ---------------------------------------------------------------------
LOG_LEVEL=info
FRONTEND_URL=http://localhost:3000
SEED_DB=true

# JWT secrets (dev fallbacks only — the production overlay refuses insecure values)
JWT_ACCESS_SECRET=commerceflow_dev_access_secret_key_2026_atleast_32
JWT_REFRESH_SECRET=commerceflow_dev_refresh_secret_key_2026_atleast_32
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Optional integrations (leave empty to disable)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@commerceflow.dev
GOOGLE_CLIENT_ID=

# --- Frontend (build-time Vite variables) ------------------------------------------
# Absolute path keeps the SPA on the same origin as nginx's /api reverse proxy.
VITE_API_URL=/api/v1

# Optional: Stripe checkout / Firebase Google auth (leave empty to disable)
VITE_STRIPE_PUBLISHABLE_KEY=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
