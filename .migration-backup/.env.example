# Environment Configuration
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control

# ============================================
# APPLICATION SETTINGS
# ============================================
NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# ============================================
# DATABASE
# ============================================
# For development (SQLite)
DATABASE_URL="file:./dev.db"

# For production (PostgreSQL) - uncomment and configure:
# DATABASE_URL="postgresql://user:password@localhost:5432/commerceflow?schema=public"
# DATABASE_POOL_URL="postgresql://user:password@localhost:5432/commerceflow?schema=public&pgbouncer=true"

# ============================================
# REDIS (Optional - for caching and job queues)
# ============================================
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=your_redis_password
# REDIS_TLS_ENABLED=false

# ============================================
# JWT AUTHENTICATION
# ============================================
# Generate secure secrets with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=generate_a_secure_32_char_secret_HERE1A2B3C4D
JWT_REFRESH_SECRET=generate_another_32_char_secret_HERE5E6F7G8H
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ============================================
# STRIPE PAYMENT PROCESSING
# ============================================
# Get your keys from: https://dashboard.stripe.com/test/apikeys
# Leave empty to disable Stripe features
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Production keys (starts with sk_live_ and whsec_):
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# ============================================
# CLOUDINARY IMAGE UPLOADS
# ============================================
# Get credentials from: https://cloudinary.com/console
# Leave empty to disable image uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ============================================
# EMAIL / SMTP
# ============================================
# For development, use a service like Mailhog or MailCatcher
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@commerceflow.dev

# For production, configure your email service:
# Gmail: smtp.gmail.com:587
# SendGrid: smtp.sendgrid.net:587
# AWS SES: email-smtp.us-east-1.amazonaws.com:587
# Example:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password
# EMAIL_FROM=noreply@yourdomain.com

# ============================================
# GOOGLE OAUTH (Optional)
# ============================================
# Get from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=

# ============================================
# FRONTEND
# ============================================
FRONTEND_URL=http://localhost:3000

# ============================================
# SECURITY & RATE LIMITING
# ============================================
# Window in milliseconds (900000 = 15 minutes)
RATE_LIMIT_WINDOW_MS=900000
# Max requests per window
RATE_LIMIT_MAX=100

# ============================================
# LOGGING
# ============================================
# Levels: fatal, error, warn, info, debug, trace, silent
LOG_LEVEL=info
